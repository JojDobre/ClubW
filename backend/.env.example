# Umiestnenie: backend/.env.example
# Skopirujte tento subor ako backend/.env a doplnte skutocne hodnoty.
# Subor .env NIKDY nedavajte do gitu - obsahuje hesla a tajne kluce.

# ===== PROSTREDIE =====
# development | production | test
NODE_ENV=development
PORT=3000

# ===== DATABAZA =====
# Predvolene hodnoty zodpovedaju docker-compose.dev.yml (sluzba client-db).
# V produkcii su tieto premenne POVINNE - aplikacia bez nich nenastartuje.
DB_HOST=localhost
DB_PORT=5435
DB_NAME=clubw_client_dev
DB_USER=client_dev
DB_PASSWORD=client_dev_password
# Sifrovane spojenie - vacsina hostovanych databaz ho vyzaduje
DB_SSL=false
# Maximalny pocet sucasnych spojeni
DB_POOL_MAX=5

# ===== BEZPECNOST =====
# POVINNE. Aplikacia bez tejto hodnoty nenastartuje (ziadna nahradna hodnota).
# Vygenerujte prikazom: openssl rand -base64 48
JWT_SECRET=
# Ako dlho plati prihlasovaci token
JWT_EXPIRES_IN=24h

# ===== CORS =====
# Adresa frontendu, ktora smie volat toto API
CORS_ORIGIN=http://localhost:3002

# ===== LICENCIA =====
CLIENT_NAME=demo_fc
# Licencny kluc od dodavatela v tvare CLUBW-XXXX-XXXX-XXXX-XXXX
LICENSE_KEY=
LICENSE_SERVER_URL=http://localhost:3001
# VEREJNY kluc licencneho servera. Bez neho sa odpoved servera neda overit
# a vsetky zapisove operacie zostanu zablokovane.
LICENSE_PUBLIC_KEY=
# Domena tohto webu - licencia moze byt viazana na konkretnu domenu
CLIENT_DOMAIN=
# Vypnutie kontroly licencie (len pre vyvoj a testy)
LICENSE_CHECK_DISABLED=false

# ===== UPLOADY =====
# Maximalna velkost nahravaneho suboru v bajtoch (predvolene 5 MB)
MAX_UPLOAD_SIZE=5242880

# ===== ODOSIELANIE E-MAILOV =====
# Potrebné pre obnovu zabudnutého hesla. Ak nie je nastavené, obsah správ
# sa vo vývoji vypíše do konzoly; v produkcii sa zaloguje chyba.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Adresa verejného webu - použije sa v odkaze na obnovu hesla
FRONTEND_URL=http://localhost:3002

# Platnosť prístupového tokenu (obnovovací platí vždy 30 dní)
JWT_EXPIRES_IN=24h

# ===== YOUTUBE =====
# Nepovinne. Bez kluca sa pri vkladani videa aj tak odvodi ID videa
# a nahladovy obrazok (priamo z adresy) a dotiahne sa nazov (verejne oEmbed).
# Kluc je potrebny LEN na automaticke zistenie dlzky videa
# (YouTube Data API v3). Bez neho sa dlzka nevyplni.
YOUTUBE_API_KEY=
