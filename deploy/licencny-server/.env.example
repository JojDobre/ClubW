# Umiestnenie: deploy/licencny-server/.env.example
# Vytvorí ho ./priprav.sh (vygeneruje heslo a kľúče). Ručne:
# skopírujte ako .env a doplňte hodnoty. Súbor .env NIKDY nedávajte do gitu.

# Doména licenčného servera - DNS záznam A musí smerovať na IP tohto VPS
DOMENA=licencie.vasadomena.sk
# E-mail pre Let's Encrypt (upozornenia na expiráciu certifikátu)
ACME_EMAIL=vas@email.sk

# Heslo databázy (openssl rand -hex 24)
DB_PASSWORD=

# Pár kľúčov na podpisovanie licencií (npm run generuj-kluce v license-server)
# SÚKROMNÝ kľúč nikdy nikomu nedávajte - kto ho má, vie vystaviť platnú licenciu.
LICENSE_PRIVATE_KEY=
# VEREJNÝ kľúč patrí do backend/.env každého webu (LICENSE_PUBLIC_KEY)
LICENSE_PUBLIC_KEY=

# Token GitHubu - len ak je repozitár súkromný (fine-grained token,
# Repository access: váš repozitár, Permissions: Contents = Read-only)
GITHUB_TOKEN=
