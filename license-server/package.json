    "db:migrate:undo": "sequelize-cli db:migrate:undo"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.5.1",
    "helmet": "^7.1.0",
    "pg": "^8.22.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8",
    "sequelize-cli": "^6.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "nodemon": "^3.0.0",
    "ts-node": "^10.9.0",
    "tsx": "^4.23.1",
    "typescript": "^5.3.0",
    "vitest": "^2.1.9",
    "supertest": "^7.2.2",
    "@types/supertest": "^7.2.1"
  }
