{
  "name": "@clubw/license-server",
  "version": "3.0.0",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "nodemon --exec ts-node src/index.ts",
    "build": "tsc",
    "build:admin": "npm run build --workspace=@clubw/license-admin",
    "test": "vitest run",
    "generuj-kluce": "node scripts/generuj-kluce.js",
    "vytvor-admina": "node dist/skripty/vytvor-admina.js",
