# Umiestnenie: license-server/.env.example
# Skopirujte ako license-server/.env a doplnte skutocne hodnoty.
# Subor .env NIKDY nedavajte do gitu.
# Na VPS sa .env nepouziva - nastavenie je v deploy/licencny-server/.env.

NODE_ENV=development
PORT=3001

# ===== DATABAZA LICENCII =====
# Zamerne oddelena od databaz klientov
DB_HOST=localhost
DB_PORT=5435
DB_NAME=clubw_licenses_dev
DB_USER=client_dev
DB_PASSWORD=
DB_SSL=false

# ===== PODPISOVANIE LICENCII =====
# Vygenerujte prikazom: npm run generuj-kluce
# SUKROMNY kluc patri VYHRADNE sem. Kto ho ma, vie si vystavit platnu licenciu.
LICENSE_PRIVATE_KEY=
# Verejny kluc - ten isty sa vklada do backend/.env kazdeho klienta
LICENSE_PUBLIC_KEY=

# ===== VERZIE Z GITHUBU =====
# Token treba len pre sukromny repozitar (fine-grained, Contents: Read-only)
GITHUB_TOKEN=
# Priecinok, kam sa stahuju baliky verzii (predvolene license-server/baliky)
BALIKY_DIR=

# ===== ADMINISTRACIA =====
# Administratora vytvorite prikazom: npm run build && npm run vytvor-admina
# Cookie prihlasenia sa v produkcii posiela len cez HTTPS. Bez HTTPS
# (napr. skuska na lokalnej sieti) ho vypnete: COOKIE_SECURE=false
COOKIE_SECURE=
# Priecinok zostavenej administracie (predvolene admin/dist)
ADMIN_DIR=
